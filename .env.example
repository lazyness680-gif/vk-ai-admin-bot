# ==========================================================
#  СЕКРЕТЫ. Этот файл НЕЛЬЗЯ коммитить в git и пересылать.
#  Скопируйте его в .env и заполните значения.
# ==========================================================

# --- ВКонтакте ---
# Ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа)
VK_TOKEN=
# Числовой ID сообщества (без минуса). Например: 123456789
VK_GROUP_ID=

# --- ProxyAPI ---
# Ключ вида sk-... из личного кабинета ProxyAPI (раздел «Ключи API»)
PROXYAPI_KEY=

# --- Необязательные настройки ---
# Модель OpenAI через ProxyAPI
LLM_MODEL=openai/gpt-4o-mini
# Базовый URL. Не меняйте без причины.
LLM_BASE_URL=https://api.proxyapi.ru/v1

# VK ID администратора, которому бот пересылает сложные диалоги (необязательно)
ADMIN_VK_ID=

# Лимиты безопасности
MAX_DAILY_LLM_CALLS=2000
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=80

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
